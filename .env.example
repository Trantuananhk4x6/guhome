DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
ADMIN_EMAIL="admin@guhomes.vn"
ADMIN_PASSWORD="change-me"
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="./public/media"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
DEPTH_PROVIDER="heuristic"
REPLICATE_API_TOKEN=""

# Object storage. STORAGE_DRIVER=local keeps derivatives in public/media, which is
# fine locally but ships 564 MB on every Vercel deploy and bills every image view
# against the site's bandwidth. Set STORAGE_DRIVER=s3 and fill these in for
# production — Cloudflare R2 works and charges nothing for egress.
S3_ENDPOINT=""
S3_BUCKET=""
S3_PUBLIC_URL=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
